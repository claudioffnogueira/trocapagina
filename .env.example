# Copie este arquivo para ".env" e preencha com os dados dos seus clusters.
# Se a senha tiver caracteres especiais (@, :, /, #...), codifique-os (URL encode).

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<USUARIO>:<SENHA>@<SEU-CLUSTER>.mongodb.net/

# Redis Cloud (Database > Connect, no painel do Redis Cloud)
REDIS_HOST=<ENDPOINT-DO-SEU-BANCO>.redis-cloud.com
REDIS_PORT=<PORTA>
REDIS_USERNAME=default
REDIS_PASSWORD=<SENHA>
