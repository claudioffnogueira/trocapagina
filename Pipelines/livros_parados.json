[
  { "$match": { "status": "disponivel" } },
  { "$lookup": { "from": "usuarios", "localField": "_id", "foreignField": "interesses.livroId", "as": "interessados" } },
  { "$match": { "interessados": { "$size": 0 } } },
  { "$lookup": { "from": "usuarios", "localField": "proprietarioId", "foreignField": "_id", "as": "dono" } },
  { "$unwind": "$dono" },
  { "$addFields": { "diasAnunciado": { "$floor": { "$divide": [ { "$subtract": ["$$NOW", "$dataCadastro"] }, 86400000 ] } } } },
  { "$project": { "_id": 0, "titulo": 1, "autor": 1, "genero": 1, "dono": "$dono.nome", "cidade": "$dono.cidade", "diasAnunciado": 1 } },
  { "$sort": { "diasAnunciado": -1 } }
]
